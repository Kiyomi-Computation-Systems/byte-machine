# Build trees. All generated objects and binaries live here and never share a
# source directory. Compiled objects are further partitioned by Chez version and
# machine type under each tree (build/<preset>/chez-objects/<version>/<machine>).
/build/
/build-*/

# CTest's cost cache, written into the SOURCE tree by any `ctest` run whose
# working directory is the repository root rather than a build tree -- which is
# what a bare `ctest -R ...` typed at the top level does. It reached a merged
# commit once because `git add -A` sweeps it up and it is neither under /build/
# nor obviously a build artifact from its name.
/Testing/

# Developer-local preset overrides
CMakeUserPresets.json

# Per-test working and temporary directories. byte_machine_add_test puts these
# under CMAKE_BINARY_DIR, so a tree here means someone configured with the
# binary directory set to the repository root. Ignored rather than left
# untracked because a directory holding only empty directories is invisible to
# `git status`, and one turned up in this repository naming a test that does not
# exist.
/test-run/

# Compiled Scheme objects must never appear in a source directory. Chez's
# compile-library and compile-program emit .so; declining generate-wpo-files
# (chez-compile.ss) keeps .wpo out of the picture today, but the pattern
# stays in case that is ever revisited. A stale object found in tree is a
# correctness hazard, not just a commit hazard, because a lane could load it
# instead of the body the build staged.
*.so
*.wpo

# Generated libraries the examples emit at run time (examples/*/README document
# the command). The suffix keeps them clear of real source, which is never
# `*.generated.sls`.
*.generated.sls
# examples/words imports its generated parser as (generated words), so the file
# has to be generated/words.sls; the whole directory is build output.
examples/words/generated/

# Akku's install directory, written by `akku install`. Akku.manifest is
# tracked; this package has no dependencies, so there is no Akku.lock.
/.akku/

# Editor and platform noise
.DS_Store
*~
\#*\#
.\#*
